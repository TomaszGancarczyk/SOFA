@using Guide.Models
@using System.Net
@using Guide.Models.ViewModels;
@using Guide.Services
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@model GraphViewModel

@{
    ViewData["Title"] = "Graph";
}


<div style="width: 90%; height: 90%">
    <h1>Weapon graph</h1>
    <canvas id="weaponChart"></canvas>
    <h1>Armor graph</h1>
    <canvas id="armorChart"></canvas>
</div>

<script>
    //shared

    //colors
    @{
        List<string> allColors = [];
        List<string> colors = [];
        allColors.Add("#FF76CE");
        allColors.Add("#F9F07A");
        allColors.Add("#5BBCFF");
        allColors.Add("#DD5746");
        allColors.Add("#AF8260");
        allColors.Add("#FF204E");
        allColors.Add("#15F5BA");
        allColors.Add("#FFFFFF");
        allColors.Add("#808836");
        allColors.Add("#ccd5ae");
        allColors.Add("#7678ed");

        foreach (string color in allColors)
        {
            colors.Add(color);
        }
    }
</script>

@* armor chart *@
<script>
    const armorCtx = document.getElementById('armorChart');

    @{
        bool isSuperHeavyCreated = false;
        string armorLabels = "[";
        for (int i = 220; i < 400; i++)
        {
            if (armorLabels.Length > 1)
            {
                armorLabels += ", ";
            }
            armorLabels += $"{i}";
        }
        armorLabels += "]";
    }
    const armorLabels = @armorLabels;

    //chart construction
    new Chart(armorCtx, {
      type: 'line',
      data: {
        labels: armorLabels,
        datasets: [
    @foreach (ArmorModel armor in Model.Armors)
    {
        if (!armor.Name.Contains("Worn") && !armor.Name.Contains("Damaged") && !armor.Name.Contains("SKAT-9") && !armor.Name.Contains("Ace Exoskeleton") && armor.Rarity == "Master" && armor.Class != "Scientist" && armor.Class != "Clothing")
        {
            if (armor.Class == "Combo") armor.Class = "Combined";
            var bulletResistance = ((JObject)JsonConvert.DeserializeObject(Shared.Reader($"{Shared.GetDatabasePath()}items\\armor\\{armor.Class.ToLower()}\\_variants\\{armor.Id}\\15.json")))["infoBlocks"][3].Value<JArray>("elements")[0].Value<JObject>("formatted").Value<JObject>("value").Value<string>("en").Replace(".", ",");
            
            if (armor.Name.Contains("Super-Heavy Armored Suit"))
            {
                if (!isSuperHeavyCreated)
                {
                    armor.Name = "Faction Super-Heavy Armored Suit";
                    isSuperHeavyCreated = true;
                }
                else
                    continue;
            }

            @:{
            @:label: '@armor.Name',
            string data = "[";
            for (int i = 220; i < 400; i++)
            {
                if (data.Length > 1)
                {
                    data += ", ";
                }
                var stat = armor.Stats.Where(stat => stat.Key == "Bullet resistance").FirstOrDefault();
                if ((double)i % Convert.ToDouble(bulletResistance) < 1 && (double)i % Convert.ToDouble(bulletResistance) > 0)
                {
                    if (armor.Properties.Where(peoperty => peoperty.Key == "Movement speed").Select(peoperty => new { Key = peoperty.Key, Value = peoperty.Value }).FirstOrDefault() != null)
                    {
                        data += armor.Properties.Where(peoperty => peoperty.Key == "Movement speed").FirstOrDefault().Value;
                    }
                    else
                    {
                        data += "0";
                    }
                }
                else
                {
                    data += "NaN";
                }
            }

            data += "]";
            @:data: @data,
            @:borderWidth: 1,
            @:borderColor: '@colors[0]',
            @:backgroundColor: '@colors[0]',
            @:},
            colors.RemoveAt(0);
            if (colors.Count == 0)
            {
                foreach (string color in allColors)
                {
                    colors.Add(color);
                }
            }
        }
    }
        ]
      },
      options: {
                pointRadius: 7,
        scales: {
          y: {
                border: {
                    color: "rgba(255,255,255,0.2)",
                    width: 2,
                },
                max: 17,
                min: -17,
                title: {
                    display: true,
                    text: 'Speed'
                },
                    grid: {
                        color: "rgba(255,255,255,0.05)",
                    },
                    ticks: {
                        display: true,
                        color: "rgba(255,255,255,0.5)",
                    }
          },
          x: {
                border: {
                    color: "rgba(255,255,255,0.2)",
                    width: 2,
                },
              title: {
                    display: true,
                    text: 'Bullet resistance'
                },
                    grid: {
                        color: "rgba(255,255,255,0.05)",
                    },
                    ticks: {
                        display: true,
                        color: "rgba(255,255,255,0.5)",
                    }
          }
        }
      }
    });
</script>


@* weapon chart *@
<script>
    const weaponCtx = document.getElementById('weaponChart');

    @{
        int maxRange = 65;

        string weaponLabels = "[";
        for (int i = 0; i <= maxRange; i++)
        {
            if (weaponLabels.Length > 1)
            {
                weaponLabels += ", ";
            }
            weaponLabels += $"{i}";
        }
        weaponLabels += "]";
    }
    const weaponLabels = @weaponLabels;

    //chart construction
    new Chart(weaponCtx, {
      type: 'line',
      data: {
        labels: weaponLabels,
        datasets: [
            @{
            List<string> weapons = [];
            }
    @foreach (WeaponModel weapon in Model.Weapons)
    {
        if (weapon.Rarity == "Master" && weapon.Class == "Assault Rifles" && weapon.Name != "DSA-58")
        // if (weapon.Rarity == "Master" && weapon.Class == "Sniper Rifles")
        {
            string upgradedWeaponPathClass = null;
            if (weapon.Class == "Assault Rifles")
                upgradedWeaponPathClass = "assault_rifle";
            else if (weapon.Class == "Machine Guns") 
                upgradedWeaponPathClass = "machine_gun";
            else if (weapon.Class == "Submachine Guns") 
                upgradedWeaponPathClass = "submachine_gun";
            else if (weapon.Class == "Sniper Rifles") 
                upgradedWeaponPathClass = "sniper_rifle";
            JToken upgradedWeapon = ((JObject)JsonConvert.DeserializeObject(Shared.Reader($"{Shared.GetDatabasePath()}items\\weapon\\{upgradedWeaponPathClass}\\_variants\\{weapon.Id}\\15.json")))["infoBlocks"][7];
            double damageDecreaseStart = upgradedWeapon.Value<double>("damageDecreaseStart");
            double damageDecreaseEnd = upgradedWeapon.Value<double>("damageDecreaseEnd");
            double maxDistance = upgradedWeapon.Value<double>("maxDistance");
            double startDamage = upgradedWeapon.Value<double>("startDamage");
            double endDamage = upgradedWeapon.Value<double>("endDamage");
            var ammoType = weapon.Stats.Where(stat => stat.Key == "Ammo type").Select(stat => new { Key = stat.Key, Value = stat.Value }).FirstOrDefault().Value;
            double ap = 0;
            if (ammoType == "5.45") ap = 0.9;
            else if (ammoType == "7.62") ap = 0.825;
            else if (ammoType == "9x39") ap = 0.8;
            else if (ammoType == "12.7") ap = 0.75;
            else if (ammoType == "5.56") ap = 0.9;
            else if (ammoType == "9 mm") ap = 0.95;
            else {}
            int fireRate = Int32.Parse(weapon.Stats.Where(stat => stat.Key == "Rate of fire").Select(stat => new { Key = stat.Key, Value = stat.Value }).FirstOrDefault().Value.Split(' ')[0]);
            double CalcTTK(double damage)
            {
                double dps = damage * fireRate / 60;
                //cent +15 = 351.23 br
                double hp = 100 + (351.23 * ap);
                double ttk = hp / dps;
                return ttk;
            }

            string data = $"[{CalcTTK(startDamage).ToString().Replace(",", ".")}";
            for (int i = 0; i <= maxRange; i++)
            {
                data += ", ";
                if (i - damageDecreaseStart < 1 && i - damageDecreaseStart >= 0) data += $"{CalcTTK(startDamage).ToString().Replace(",", ".")}";
                else if (i - damageDecreaseEnd < 1 && i - damageDecreaseEnd >= 0) data += $"{CalcTTK(endDamage).ToString().Replace(",", ".")}";
                else if (i - maxDistance < 1 && i - maxDistance >= 0) data += $"{CalcTTK(endDamage).ToString().Replace(",", ".")}";
                else if (i == (maxRange - 1) && i < maxDistance) data += $"{CalcTTK(endDamage).ToString().Replace(",", ".")}";
                else data += "";
            }
            data += "]";
            weapons.Add(weapon.Name);
            if (weapon.Name == "АК-15") 
                weapon.Name = "AK-15";
            if (weapon.Name == "АМ-17")
                weapon.Name = "AM-17";
            if (weapon.Name.Contains("VSS-M"))
                weapon.Name = "VSS-M Vintorez";
            if (weapon.Name.Contains("191"))
                weapon.Name = "QBZ-191";
            if (weapon.Name == "HK XM8S")
            {
                continue;
            }
            if (weapon.Name == "HK XM8")
                weapon.Name = "HK XM8/HK XM8S";
            @:{
            @:label: '@weapon.Name',
            @:data: @data,
            @:borderWidth: 2,
            @:borderColor: '@colors[0]',
            @:backgroundColor: '@colors[0]',
            @:},
            colors.RemoveAt(0);
            if (colors.Count == 0)
            {
            foreach (string color in allColors)
                {
                colors.Add(color);
                }
            }
        }
    }
        ]
      },
      options: {
          pointRadius: 0,
          spanGaps: true,
        scales: {
          y: {
                border: {
                    color: "rgba(255,255,255,0.2)",
                    width: 2,
                },
                max: 0.95,
                min: 0.55,
                title: {
                    display: true,
                    text: 'TTK (s)'
                },
                    grid: {
                        color: "rgba(255,255,255,0.05)",
                    },
                    ticks: {
                        display: true,
                        color: "rgba(255,255,255,0.5)",
                    }
          },
          x: {
                border: {
                    color: "rgba(255,255,255,0.2)",
                    width: 2,
                },
              title: {
                    display: true,
                    text: "Distance (m)",
                },
                    grid: {
                        color: "rgba(255,255,255,0.05)",
                    },
                    ticks: {
                        display: true,
                        color: "rgba(255,255,255,0.5)",
                    }
          }
        }
      }
    });
</script>